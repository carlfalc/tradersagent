# Copy this file to .env (same folder) and paste your keys after the = signs.
# Never share this file.

# --- Jev (and Claude) -------------------------------------------------------
# Vercel AI Gateway key: https://vercel.com/dashboard -> AI Gateway -> API Keys -> Create key
# The free tier works but is slow (about one Jev call every 2 seconds).
# $5 of AI Gateway credits removes that limit, and is needed for Claude (the 24/7 bot's brain).
AI_GATEWAY_API_KEY=

# Optional: a direct TypeSafe key, if you're off their waitlist.
TYPESAFE_API_KEY=

# --- 24/7 bot only (Path 2) -------------------------------------------------
# Bybit API key and secret. Start with a DEMO TRADING key (fake money).
# The key must NOT have withdrawal permission. Lock it to your server's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_MODE=demo

# Hard limits, always on:
MAX_POSITION_USD=1000
MAX_DAILY_LOSS_USD=50

# --- MetaApi FX / indices / commodities bot (Path 3) ------------------------
# Trades your GAINEDGE instruments (Gold, Hang Seng, DAX, NAS100, FX...) through a
# MetaApi-linked MetaTrader 5 account. Start on a DEMO account. The account must be
# DEPLOYED on metaapi.cloud (that's what uses credits).
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=london
# demo (default) or live. live also needs the JEV_LIVE_CONFIRM phrase below.
METAAPI_ACCOUNT_TYPE=demo
# Lots traded per instrument. Default 2. NOTE: 2 lots is large — make sure
# MAX_DAILY_LOSS_USD above is set high enough that a normal move won't halt the bot.
MAX_LOTS=2
# Quick-win take-profit and stop-loss per position, in account currency (0 = off).
TAKE_PROFIT_USD=25
STOP_LOSS_USD=20

# --- RON brain (optional): use GAINEDGE's engine to set the bias (run fxbot --brain ron) ---
# Auth, pick ONE:
#   (a) sign in as your GAINEDGE user — no service key needed:
#         GAINEDGE_EMAIL + GAINEDGE_PASSWORD  (the brain logs in and refreshes the token itself)
#   (b) a service-role key, if you have it:  GAINEDGE_SERVICE_KEY
GAINEDGE_SUPABASE_URL=https://ecsztqtyttnqdnsphxip.supabase.co
GAINEDGE_SUPABASE_ANON_KEY=
GAINEDGE_EMAIL=
GAINEDGE_PASSWORD=
GAINEDGE_SERVICE_KEY=
RON_TIMEFRAME=15m

# Claude model for the big-picture brain (via the same Vercel key). If this slug is wrong
# or retired, the bot automatically falls back to other current Claude models.
CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# Real money: leave this blank. Only set BYBIT_MODE=live / METAAPI_ACCOUNT_TYPE=live, and
# this line to the exact phrase "I accept the risk of trading real money", after weeks of demo results.
JEV_LIVE_CONFIRM=

# --- TradingView webhook (optional): run the bot with --signal webhook ---
# TradingView POSTs your RSI Strategy alerts to the bot instead of it computing the cross locally.
# This is signal TRANSPORT only — it does not change the strategy's edge.
# Generate a strong token once and paste the SAME value into every TradingView alert message:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=
# Port for the receiver (127.0.0.1 only; front it with a Cloudflare Tunnel or nginx+TLS):
WEBHOOK_PORT=8799
